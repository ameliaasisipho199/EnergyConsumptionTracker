<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Electricity Consumption Report"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvApplianceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appliance Name: "
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvDailyConsumption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Consumption: "
            android:textSize="18sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvMonthlyConsumption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monthly Consumption: "
            android:textSize="18sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvMonthlyCost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monthly Cost: "
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvEfficiencyRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Energy Efficiency Rating: "
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvRecommendation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recommendation: "
            android:textSize="18sp"
            android:padding="8dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnCalculateAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate Again"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnExitResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exit" />

    </LinearLayout>

</ScrollView>