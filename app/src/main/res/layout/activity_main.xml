<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Energy Consumption Tracker"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome! Monitor your household electricity usage and save on your monthly bill."
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <ImageView
        android:id="@+id/ivElectricity"
        android:layout_width="220dp"
        android:layout_height="180dp"
        android:src="@drawable/electricity_image"
        android:contentDescription="Electricity consumption image"
        android:scaleType="centerInside"
        android:layout_marginBottom="25dp" />

    <!-- The button width is set to wrap_content with a minWidth to ensure it is prominent
         but does not exceed the Material Design recommendation of 320dp on large screens. -->
    <Button
        android:id="@+id/btnStartCalculation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="250dp"
        android:text="Start Calculation"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnExit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="250dp"
        android:text="Exit" />

</LinearLayout>